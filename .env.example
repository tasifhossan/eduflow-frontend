# EduFlow Frontend Environment Variables

# Backend API Base URL (Do NOT include an /api suffix)
NEXT_PUBLIC_API_URL="http://localhost:5000"

# Google OAuth 2.0 Client ID (to be added later for Google Identity Services)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Application Name
NEXT_PUBLIC_APP_NAME="EduFlow"
