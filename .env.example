# EduFlow Frontend Environment Variables

# Backend API Base URL (Do NOT include an /api suffix)
NEXT_PUBLIC_API_URL="http://localhost:5000"

# Public Site URL for metadataBase, sitemap, and canonical links
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Application Name
NEXT_PUBLIC_APP_NAME="EduFlow"

# Developer shortcuts on /login (development only: set to 'true' to display quick demo login shortcuts)
# NEXT_PUBLIC_DEV_SHORTCUTS="true"
